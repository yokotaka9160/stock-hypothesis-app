# このファイルを .env にコピーして値を設定する（.env はコミットしない）

# Gemini API の APIキー（Google AI Studio で発行する。無料枠のみ使う）
GEMINI_API_KEY=

# 使う Gemini のモデル（未設定の場合は gemini-3.5-flash）
GEMINI_MODEL=

# Alpha Vantage の APIキー（https://www.alphavantage.co/support/#api-key で発行する。無料枠のみ使う）
# 決算発表の時刻が yfinance で取れない回だけ、市場前／市場後の区分を調べるのに使う
ALPHAVANTAGE_API_KEY=

# Django の秘密鍵（未設定の場合はローカル専用の仮の値が使われる）
DJANGO_SECRET_KEY=

# デバッグモード（true / false）
DJANGO_DEBUG=true
